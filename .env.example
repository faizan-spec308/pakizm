# Pakizm environment variables — copy to .env and fill in real values.
# .env is git-ignored; never commit real keys. .env.example (this file) is safe to commit.

# Google Gemini API key for the image-enhancement workflow (scripts/gemini/).
# Get one at https://aistudio.google.com/apikey . Kept separate from Claude Code auth.
GEMINI_API_KEY=

# Optional: pin the image model. If unset, the workflow verifies and uses a
# supported image model from the live API. Example: gemini-2.5-flash-image
GEMINI_MODEL=
